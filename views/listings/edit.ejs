<% layout("/layout/boilerplate.ejs") %>
<body>
    <div class="row mt-3 mb-5">
        <div class="col-md-8 offset-md-2">
            <h3 class="mb-4 text-dark fw-bold">Edit Your Listing</h3>
            <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="title" class="form-label fw-semibold">Title</label>
                    <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control" required>
                </div>
                
                <div class="mb-3">
                    <label for="description" class="form-label fw-semibold">Description</label>
                    <textarea name="listing[description]" class="form-control" rows="4" required><%= listing.description %></textarea>
                </div>
                
                <div class="mb-3">
                    <label for="image" class="form-label fw-semibold">Image Link</label>
                    <input name="listing[image]" value="<%= listing.image.url %>" type="text" class="form-control">
                </div>
                
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label fw-semibold">Price</label>
                        <input name="listing[price]" value="<%= listing.price %>" type="number" class="form-control" required>
                    </div>
                    
                    <div class="mb-3 col-md-8">
                        <label for="location" class="form-label fw-semibold">Location</label>
                        <input name="listing[location]" value="<%= listing.location.trim() %>" type="text" class="form-control" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="country" class="form-label fw-semibold">Country</label>
                    <input name="listing[country]" value="<%= listing.country.trim() %>" type="text" class="form-control" required>
                </div>
                
                <button class="btn btn-dark add-btn w-100 rounded-pill py-2.5 mt-3 shadow-sm" type="submit">Update Listing</button>
            </form>
        </div>
    </div>
</body>
