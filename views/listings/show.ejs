<% layout("/layout/boilerplate.ejs") %>
<body>
    <div class="row mt-4 mb-5">
        <div class="col-md-8 offset-md-2">
            <h3 class="fw-bold mb-4 text-dark"><%= listing.title %></h3>
            
            <div class="card show-card border-0 rounded-4 overflow-hidden shadow-sm mb-4">
                <div class="show-img-container" style="height: 28rem; overflow: hidden; background-color: #f7f7f7;">
                    <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="<%= listing.title %>" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
                
                <div class="card-body px-4 py-4">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge bg-light text-dark border border-secondary-subtle py-2 px-3 rounded-pill fs-6 fw-normal">
                            <i class="fa-solid fa-location-dot text-danger me-1"></i><%= listing.location %>, <%= listing.country %>
                        </span>
                        <span class="badge bg-light text-dark border border-secondary-subtle py-2 px-3 rounded-pill fs-6 fw-normal">
                            <i class="fa-solid fa-indian-rupee-sign text-success me-1"></i>₹ <%= listing.price.toLocaleString("en-IN") %> / night
                        </span>
                    </div>

                    <!-- Hosted By -->
                    <div class="d-flex align-items-center gap-2 mb-3 mt-3">
                        <div class="owner-avatar d-flex align-items-center justify-content-center rounded-circle" style="width: 38px; height: 38px; background: linear-gradient(135deg, #fe424d, #ff6b6b); color: white; font-weight: 700; font-size: 1rem;">
                            <%= listing.owner.username.charAt(0).toUpperCase() %>
                        </div>
                        <div>
                            <span class="text-muted small">Hosted by</span>
                            <p class="mb-0 fw-bold text-dark" style="font-size: 0.95rem;"><%= listing.owner.username %></p>
                        </div>
                    </div>
                    
                    <h5 class="fw-bold text-dark mt-4 mb-2">Description</h5>
                    <p class="card-text text-secondary lh-lg fs-6 mb-4" style="text-align: justify;">
                        <%= listing.description %>
                    </p>
                    
                    <hr class="my-4 opacity-25">
                    
                    <div class="d-flex gap-3 align-items-center flex-wrap">
                        <!-- Book Now: Show ONLY if user is NOT the owner -->
                        <% if (!currUser || !listing.owner._id.equals(currUser._id)) { %>
                            <a href="/listings/<%= listing._id %>/book" class="btn px-4 py-2 rounded-pill shadow-sm fw-bold book-now-btn" style="background: linear-gradient(135deg, #00b894, #00cec9); color: white; border: none; min-width: 140px; transition: all 0.3s ease; font-size: 1rem;">
                                <i class="fa-solid fa-calendar-check me-2"></i>Book Now
                            </a>
                        <% } %>

                        <!-- Edit/Delete: Show ONLY if user IS the owner -->
                        <% if (currUser && listing.owner._id.equals(currUser._id)) { %>
                            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark px-4 py-2 rounded-pill shadow-sm" style="background-color: #222222; border: none; min-width: 110px; transition: all 0.3s ease;">
                                <i class="fa-solid fa-pen-to-square me-2"></i>Edit
                            </a>
                            
                            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="m-0">
                                <button class="btn btn-danger px-4 py-2 rounded-pill shadow-sm" style="background-color: #fe424d; border: none; min-width: 110px; transition: all 0.3s ease;">
                                    <i class="fa-solid fa-trash-can me-2"></i>Delete
                                </button>
                            </form>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Reviews Section -->
            <div class="reviews-section mt-5">
                <h4 class="fw-bold text-dark mb-4">
                    <i class="fa-solid fa-star text-warning me-2"></i>Reviews
                    <span class="text-muted fw-normal fs-6">(<%= listing.reviews.length %>)</span>
                </h4>

                <!-- Add Review Form: Show only if logged in AND not the owner -->
                <% if (currUser && !listing.owner._id.equals(currUser._id)) { %>
                    <div class="card border-0 rounded-4 shadow-sm mb-4">
                        <div class="card-body px-4 py-4">
                            <h6 class="fw-bold text-dark mb-3">
                                <i class="fa-solid fa-pen-fancy me-2" style="color: #00b894;"></i>Leave a Review
                            </h6>
                            <form action="/listings/<%= listing._id %>/reviews" method="POST">
                                <!-- Star Rating -->
                                <div class="mb-3">
                                    <label class="form-label fw-semibold text-dark">Rating</label>
                                    <fieldset class="starability-fade">
                                        <input type="radio" id="rate5" name="review[rating]" value="5" />
                                        <label for="rate5" title="Amazing">5 stars</label>
                                        <input type="radio" id="rate4" name="review[rating]" value="4" checked />
                                        <label for="rate4" title="Very good">4 stars</label>
                                        <input type="radio" id="rate3" name="review[rating]" value="3" />
                                        <label for="rate3" title="Average">3 stars</label>
                                        <input type="radio" id="rate2" name="review[rating]" value="2" />
                                        <label for="rate2" title="Not good">2 stars</label>
                                        <input type="radio" id="rate1" name="review[rating]" value="1" />
                                        <label for="rate1" title="Terrible">1 star</label>
                                    </fieldset>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold text-dark">Comment</label>
                                    <textarea name="review[comment]" class="form-control" rows="3" placeholder="Share your experience..." required></textarea>
                                </div>
                                <button type="submit" class="btn px-4 py-2 rounded-pill shadow-sm fw-semibold" style="background: linear-gradient(135deg, #00b894, #00cec9); color: white; border: none; transition: all 0.3s ease;">
                                    <i class="fa-solid fa-paper-plane me-2"></i>Submit Review
                                </button>
                            </form>
                        </div>
                    </div>
                <% } %>

                <!-- Display All Reviews -->
                <% if (listing.reviews.length > 0) { %>
                    <% for (let review of listing.reviews) { %>
                        <div class="card review-card border-0 rounded-4 shadow-sm mb-3">
                            <div class="card-body px-4 py-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <div class="review-avatar d-flex align-items-center justify-content-center rounded-circle" style="width: 34px; height: 34px; background: linear-gradient(135deg, #6c5ce7, #a29bfe); color: white; font-weight: 700; font-size: 0.85rem;">
                                            <%= review.author.username.charAt(0).toUpperCase() %>
                                        </div>
                                        <div>
                                            <p class="mb-0 fw-bold text-dark" style="font-size: 0.9rem;"><%= review.author.username %></p>
                                            <div class="review-stars">
                                                <% for (let i = 1; i <= 5; i++) { %>
                                                    <% if (i <= review.rating) { %>
                                                        <i class="fa-solid fa-star text-warning" style="font-size: 0.75rem;"></i>
                                                    <% } else { %>
                                                        <i class="fa-regular fa-star text-muted" style="font-size: 0.75rem;"></i>
                                                    <% } %>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Delete review: Only the review author can delete -->
                                    <% if (currUser && review.author._id.equals(currUser._id)) { %>
                                        <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="m-0">
                                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1" style="font-size: 0.8rem; transition: all 0.3s ease;">
                                                <i class="fa-solid fa-xmark me-1"></i>Delete
                                            </button>
                                        </form>
                                    <% } %>
                                </div>
                                <p class="text-secondary mb-0 mt-1" style="font-size: 0.95rem;"><%= review.comment %></p>
                            </div>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="text-center py-4">
                        <i class="fa-regular fa-comment-dots text-muted mb-2" style="font-size: 2.5rem; opacity: 0.3;"></i>
                        <p class="text-muted mt-2 mb-0">No reviews yet. Be the first to share your experience!</p>
                    </div>
                <% } %>
            </div>

        </div>
    </div>
</body>
