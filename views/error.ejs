<% layout("/layout/boilerplate.ejs") %>
<div class="row mt-5 mb-5">
    <div class="col-md-8 offset-md-2 text-center py-5 px-4 shadow-lg rounded-4 bg-white border-top border-danger border-4 animate__animated animate__fadeIn">
        <div class="mb-4">
            <i class="fa-solid fa-triangle-exclamation text-danger" style="font-size: 3.5rem;"></i>
        </div>
        <h2 class="text-dark fw-bold mb-3"><%= message %></h2>
        <p class="text-muted mb-4 fs-5">
            The page or operation you requested encountered an issue. Please verify your request or return to safety.
        </p>
        <a href="/listings" class="btn btn-dark px-4 py-2 rounded-pill shadow-sm" style="background-color: #fe424d; border: none; transition: all 0.3s ease;">
            <i class="fa-solid fa-house me-2"></i>Back to Listings
        </a>
    </div>
</div>
